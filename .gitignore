dist/
.DS_Store

# Taller privado: borradores de posts, diagramas, decks y notas de casos reales.
# Nunca se versiona. Es el unico lugar del arbol donde puede haber material
# identificable, y por eso mismo lo que sale de aqui hacia una superficie
# publica (repo o post) pasa antes por check-neutralidad.sh --msg.
private/

# Lista local de terminos prohibidos para la verificacion de neutralidad.
# Nunca se versiona: una lista de prohibidos publicada republica exactamente
# lo que se pretende ocultar. Ver scripts/check-neutralidad.sh.
.neutralidad-local

# Herramientas instaladas localmente por el instalador de skills (skill-creator
# y companeras) y su estado. No son parte de la suite: versionarlas
# republicaria codigo de terceros dentro de un repo publico, y ademas rompe la
# auditoria de neutralidad, que acabaria analizando vocabulario ajeno.
.claude/skills/
.claude/commands/
.agents/
